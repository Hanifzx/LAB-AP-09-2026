GENRE_RAPI = {"pop": "Pop", "rock": "Rock", "jazz": "Jazz", "rnb": "RnB", "dangdut": "Dangdut"}


# UBAH DETIK KE MENIT 
def format_durasi(detik):
    menit = detik // 60   
    sisa = detik % 60     
    if sisa < 10:
        sisa_teks = "0" + str(sisa)  
    else:
        sisa_teks = str(sisa)
    return str(menit) + ":" + sisa_teks 


# 1. TAMBAH LAGU 
def tambah_lagu(playlist, genre_set, judul, artis, genre, durasi):
    genre = GENRE_RAPI.get(genre.lower(), genre.capitalize())
    lagu = (judul, artis, genre, durasi)  
    playlist.append(lagu)                 # list playlist
    genre_set.add(genre)                  # set otomatis abaikan genre yang kembar
    print(f"Lagu '{judul}' oleh {artis} berhasil ditambahkan!")


# 2. TAMPILKAN PLAYLIST 
def tampilkan_playlist(playlist):
    if len(playlist) == 0:
        print("Playlist masih kosong.")
        return

    print("=" * 60)
    print("No".ljust(4) + "Judul".ljust(24) + "Artis".ljust(16) + "Genre".ljust(9) + "Durasi".rjust(7))
    print("=" * 60)

    nomor = 1
    total_detik = 0
    
    for judul, artis, genre, durasi in playlist:
        print(str(nomor).ljust(4) + judul.ljust(24) + artis.ljust(16) + genre.ljust(9) + format_durasi(durasi).rjust(7))
        total_detik = total_detik + durasi
        nomor = nomor + 1

    print("=" * 60)
    print(f"Total durasi playlist: {total_detik // 60} menit {total_detik % 60} detik")


# 3. FILTER GENRE, kembalikan list berisi lagu dengan gendre yang di cari 
def filter_genre(playlist, genre_target):
    # 
    return [lagu for lagu in playlist if lagu[2].lower() == genre_target.lower()]


#  4: HAPUS LAGU 
def hapus_lagu(playlist, nomor):
    if nomor < 1 or nomor > len(playlist):
        print("Error: Nomor lagu tidak valid!")
    else:
        # n_layar = 1, i=0, so nomor - 1
        lagu = playlist.pop(nomor - 1)  # hps+back is
        print(f"Lagu '{lagu[0]}' oleh {lagu[1]} berhasil dihapus!")


# 5. STATISTIK PLAYLIST 
def statistik_playlist(playlist, genre_set):
    if len(playlist) == 0:
        print("Playlist masih kosong, belum ada statistik.")
        return

    # Dct hitung lagu per genre
    distribusi = {}
    for lagu in playlist:
        genre = lagu[2]
        if genre in distribusi:
            distribusi[genre] = distribusi[genre] + 1  # ada, tambah 1
        else:
            distribusi[genre] = 1                      # baru, mulai dari 1


    terpanjang = playlist[0]
    terpendek = playlist[0]
    for lagu in playlist:
        if lagu[3] > terpanjang[3]:
            terpanjang = lagu
        if lagu[3] < terpendek[3]:
            terpendek = lagu

    print("=" * 40)
    print(" STATISTIK PLAYLIST PLAYTUNE")
    print("=" * 40)
    print(f" Total lagu : {len(playlist)}")
    print(f" Jumlah genre : {len(genre_set)}")
    print(f" Daftar genre : {genre_set}")
    print(" Distribusi genre:")
    for genre in distribusi:
        jumlah = distribusi[genre]
        print(" " + genre.ljust(7) + ": " + "#" * jumlah + f" ({jumlah})")
    print(f" Lagu terpanjang : {terpanjang[0]} ({format_durasi(terpanjang[3])})")
    print(f" Lagu terpendek : {terpendek[0]} ({format_durasi(terpendek[3])})")
    print("=" * 40)



playlist = []      
genre_set = set()  

