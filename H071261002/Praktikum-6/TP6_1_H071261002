# TAMBAH BUKU 
def tambah_buku(inventaris, judul, penulis, harga, stok):
    buku = {"judul": judul, "penulis": penulis, "harga": harga, "stok": stok} #dict
    inventaris.append(buku) 
    print(f"Buku '{judul}' berhasil ditambahkan!")


# CARI BUKU 
def cari_buku(inventaris, kata_kunci):
    hasil = []

    for buku in inventaris:
        if kata_kunci.lower() in buku["judul"].lower(): 
            hasil.append(buku)

    if len(hasil) == 0:
        print("Tidak ada buku yang cocok dengan kata kunci tersebut.")
    else:
        print(f"Ditemukan {len(hasil)} buku:")
        nomor = 1  
        for buku in hasil:
            print(f" {nomor}. {buku['judul']} - {buku['penulis']} | Rp{buku['harga']} | Stok: {buku['stok']}")
            nomor = nomor + 1


# UPDATE STOK 
def update_stok(inventaris, judul, jumlah):
    ditemukan = False  

    for buku in inventaris:
        if buku["judul"].lower() == judul.lower():
            ditemukan = True
            stok_baru = buku["stok"] + jumlah  # htng 

            if stok_baru < 0:
                print(f"Gagal! Stok '{buku['judul']}' tidak cukup (stok saat ini: {buku['stok']}).")
            else:
                buku["stok"] = stok_baru  
                if jumlah > 0:
                    print(f"Stok '{buku['judul']}' bertambah {jumlah}. Stok sekarang: {stok_baru}")
                elif jumlah < 0:
                    print(f"Stok '{buku['judul']}' berkurang {-jumlah}. Stok sekarang: {stok_baru}")
                else:
                    print(f"Stok '{buku['judul']}' tidak berubah. Stok sekarang: {stok_baru}")

    if ditemukan == False:
        print(f"Error: Buku '{judul}' tidak ditemukan!")


