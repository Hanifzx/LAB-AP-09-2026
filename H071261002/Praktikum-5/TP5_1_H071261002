# SOAL 1 - PALINDROM TERPANJANG (versi diperbaiki & dirampingkan)

ALFABET = "abcdefghijklmnopqrstuvwxyz"

# Membuang selain huruf, lalu mengubah ke huruf kecil
def bersihkan_teks(teks):
    hasil = ""
    for karakter in teks:
        huruf = karakter.lower()
        if huruf in ALFABET:
            hasil += huruf
    return hasil

# Mengembalikan (True, -1) jika palindrom, atau (False, indeks_pertama_beda)
def cek_palinrome(teks):
    terbalik = "".join(reversed(teks))
    if teks == terbalik:
        return (True, -1)
    for i in range(len(teks)):
        if teks[i] != terbalik[i]:
            return (False, i)

# Mencari palindrom terpanjang pada teks yang SUDAH bersih
def inti_palinrome(bersih):
    terbaik = {"teks": "", "panjang": 0, "indeks_awal": 0}

    for i in range(len(bersih)):                 # titik awal potongan
        for j in range(i + 1, len(bersih) + 1):  # titik akhir potongan
            potongan = bersih[i:j]               # slicing
            # cek panjang dulu (murah), baru cek palindrom (mahal)
            if len(potongan) > terbaik["panjang"]:
                sudah_palindrom, _ = cek_palinrome(potongan)   # ambil True/False saja
                if sudah_palindrom:
                    terbaik = {"teks": potongan,
                               "panjang": len(potongan),
                               "indeks_awal": i}
    return terbaik

masukan = input("Masukkan teks prasasti: ")
bersih = bersihkan_teks(masukan)                 # dibersihkan SEKALI saja
print()
print("Teks Bersih:", bersih)
print("Output Terharap:", inti_palinrome(bersih))