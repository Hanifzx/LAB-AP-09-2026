ALFABET = "abcdefghijklmnopqrstuvwxyz"   

def cek_kata(teks, kata):
    daftar_indeks = []
    teks_kecil = teks.lower()
    kata_kecil = kata.lower()
    if kata_kecil == "":                 
        return daftar_indeks
    start = 0
    while True:
        posisi = teks_kecil.find(kata_kecil, start)
        if posisi == -1:                 # -1 = tidak ditemukan lagi, berhenti
            break
        daftar_indeks.append(posisi)     
        start = posisi + 1               # lanjut cari setelah posisi ini
    return daftar_indeks

def cek_batas_kata(teks, i, panjang):
    # cek karakter SEBELUM kata 
    if i > 0:                                  # kalau bukan di awal teks
        if teks[i - 1].lower() in ALFABET:     # huruf sebelumnya bukan kata utuh
            return False
    # cek karakter SESUDAH kata 
    akhir = i + panjang                        
    if akhir < len(teks):                      # kalau bukan di akhir teks
        if teks[akhir].lower() in ALFABET:     # huruf setelahnya bukan kata utuh
            return False
    return True

def sensor_kata(teks, kata, simbol):
    panjang = len(kata)
    semua_indeks = cek_kata(teks, kata)
    hasil = ""
    terakhir = 0
    indeks_disensor = []

    for i in semua_indeks:
        if cek_batas_kata(teks, i, panjang):                 
            hasil = hasil + teks[terakhir:i] + simbol * panjang
            terakhir = i + panjang
            indeks_disensor.append(i)                          

    hasil = hasil + teks[terakhir:]                          
    return (hasil, len(indeks_disensor), indeks_disensor)

teks_masukan = input("Masukkan Teks: ")
kata_target = input("Masukkan kata target: ")
simbol_masukan = input("Masukkan simbol: ")
if simbol_masukan == "":
    simbol_masukan = "*"            

teks_sensor, jumlah, daftar_indeks = sensor_kata(teks_masukan, kata_target, simbol_masukan)
print("Hasil Teks:", teks_sensor)
print("Jumlah:", jumlah, "| Indeks:", daftar_indeks)