import re

def validasi_username(username):
   
    pola = r"^[A-Za-z][A-Za-z0-9_]{4,11}$"
    return re.match(pola, username) is not None
  
daftar_valid = []
 
print("=== Registrasi Username ===")
print("Ketik 'SELESAI' untuk mengakhiri.")
 
while True:
    username = input("\nMasukkan username: ")
 
    if username == "SELESAI":
        break
 
    if validasi_username(username):
        print("Username tersedia.")
        daftar_valid.append(username)
    else:
        print("Username tidak valid!")
 
print("\n=== Rekapitulasi ===")
print("Username valid:")
for nomor, nama in enumerate(daftar_valid, start=1):
    print(f"{nomor}. {nama}") # v t t
 
print(f"\nJumlah username valid: {len(daftar_valid)}")
